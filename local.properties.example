# Copy this file to local.properties and fill in your values.
# local.properties is gitignored and never committed.

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firestore paths
# SMS_JOBS_PATH must be a 3-segment path (collection/doc/subcollection)
SMS_JOBS_PATH=sim_module/sms/sms_jobs
# USERS_PATH must be a 1-segment (top-level) or 3-segment path; NOT 2-segment
USERS_PATH=ttgo_users
DEVICE_DOC_PATH=sim_module/device

# Quota model (not configurable):
#   phone unverified -> 0 SMS/day (sending disabled until the number is verified)
#   phone verified   -> assigned_quota from sim_module/device/free_sms_quota (default 10)
# Email verification does not affect the SMS quota.

# WhatsApp gateway (baileys service). Both are public addresses and both are
# remote-first: device-doc fields wa_service_url / wa_portal_url override them
# at runtime, so moving the gateway is a console edit and not a release.
# No gateway credential belongs here — anything compiled in is readable from
# the published APK. Each user pastes their own key from the portal instead.
WHATSAPP_SERVICE_URL=https://w2.innovorix.com
WHATSAPP_PORTAL_URL=https://w2.innovorix.com

# History auto-poll interval in seconds while the screen is visible
HISTORY_POLL_INTERVAL_SECONDS=10

# V2: WiFi arrival detection
# Minutes the device must stay connected to the target BSSID before triggering
WIFI_STABILITY_MINUTES=10
# Floor for the adaptive wait (routine learning cannot reduce below this)
MIN_WIFI_STABILITY_MINUTES=5
