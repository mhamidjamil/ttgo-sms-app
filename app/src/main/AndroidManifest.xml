<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- V2: WiFi arrival detection -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- WiFi and location are how arrival is detected, but a phone without
         either is still a perfectly good SMS sender, so neither may narrow who
         can install the app on Play. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12 and above show a precise/approximate choice, and refuse the
         precise prompt unless the approximate one is declared alongside it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- This reverses the earlier decision to leave background location out. A
         geofence that fires while the app is closed is location delivered to a
         dead process, and no phone will do that without this permission, so
         detection that survives the app not running cannot exist without it.
         The cost lands at release time, not build time: the next Play
         submission needs the background-location declaration form, the demo
         video and the prominent disclosure (docs/V4-GEOFENCE-HYBRID.md
         section 2.9). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Held only while an arrival is being confirmed. Doze otherwise parks the
         sweep and the dwell clock with it, which is how a night arrival was
         never counted. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Step counter, used only to tell a real stop from driving past. Optional:
         without it the wait falls back to counting plain elapsed time. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Restart monitoring after the phone reboots -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spotwire">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Spotwire">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- V2: Arrival monitoring foreground service -->
        <service
            android:name=".services.ArrivalService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Brings monitoring back after a restart, an app update, or the phone's
             battery manager killing the service. -->
        <receiver
            android:name=".services.ArrivalWatchdogReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.spotwire.app.ARRIVAL_WATCHDOG" />
            </intent-filter>
        </receiver>

        <!-- Woken by the system when a place's fence is crossed. It needs no
             intent-filter: the geofencing service sends to it by name through
             the pending intent it was registered with. -->
        <receiver
            android:name=".services.GeofenceEventReceiver"
            android:exported="false" />

        <!-- Lets the share sheet read the exported monitoring log. A file in the
             app's own cache is unreadable to any other app without this. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.spotwire.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
